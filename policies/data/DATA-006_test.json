[
  {
    "name": "blocks Glob in ssh dir",
    "tool_name": "Glob",
    "tool_input": {"pattern": "*", "path": "/Users/me/.ssh"},
    "expect": "block"
  },
  {
    "name": "blocks Glob in aws dir",
    "tool_name": "Glob",
    "tool_input": {"pattern": "**/*", "path": "/Users/me/.aws/"},
    "expect": "block"
  },
  {
    "name": "blocks Glob for pem files",
    "tool_name": "Glob",
    "tool_input": {"pattern": "**/*.pem"},
    "expect": "block"
  },
  {
    "name": "blocks Glob for id_rsa",
    "tool_name": "Glob",
    "tool_input": {"pattern": "**/id_rsa*"},
    "expect": "block"
  },
  {
    "name": "blocks Glob for .env files",
    "tool_name": "Glob",
    "tool_input": {"pattern": "**/.env*"},
    "expect": "block"
  },
  {
    "name": "blocks Grep in ssh dir",
    "tool_name": "Grep",
    "tool_input": {"pattern": "BEGIN", "path": "/Users/me/.ssh"},
    "expect": "block"
  },
  {
    "name": "blocks Grep in gcloud config",
    "tool_name": "Grep",
    "tool_input": {"pattern": "token", "path": "/Users/me/.config/gcloud"},
    "expect": "block"
  },
  {
    "name": "blocks Grep restricted to .env glob",
    "tool_name": "Grep",
    "tool_input": {"pattern": "KEY", "glob": "*.env"},
    "expect": "block"
  },
  {
    "name": "blocks Grep restricted to .env.production glob",
    "tool_name": "Grep",
    "tool_input": {"pattern": "KEY", "glob": ".env.production"},
    "expect": "block"
  },
  {
    "name": "allows Glob for go files",
    "tool_name": "Glob",
    "tool_input": {"pattern": "**/*.go", "path": "/Users/me/project"},
    "expect": "allow"
  },
  {
    "name": "allows Grep in project",
    "tool_name": "Grep",
    "tool_input": {"pattern": "TODO", "path": "/Users/me/project/src"},
    "expect": "allow"
  },
  {
    "name": "allows Grep with go glob",
    "tool_name": "Grep",
    "tool_input": {"pattern": "func main", "glob": "*.go"},
    "expect": "allow"
  },
  {
    "name": "allows Glob without path",
    "tool_name": "Glob",
    "tool_input": {"pattern": "src/**/*.ts"},
    "expect": "allow"
  }
]
