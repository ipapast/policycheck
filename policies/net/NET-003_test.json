[
  {
    "name": "blocks AWS metadata endpoint",
    "tool_name": "Bash",
    "tool_input": {"command": "curl http://169.254.169.254/latest/meta-data/iam/security-credentials/"},
    "expect": "block"
  },
  {
    "name": "blocks AWS metadata with wget",
    "tool_name": "Bash",
    "tool_input": {"command": "wget -qO- http://169.254.169.254/latest/meta-data/"},
    "expect": "block"
  },
  {
    "name": "blocks GCP metadata endpoint",
    "tool_name": "Bash",
    "tool_input": {"command": "curl -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/"},
    "expect": "block"
  },
  {
    "name": "blocks Azure metadata endpoint",
    "tool_name": "Bash",
    "tool_input": {"command": "curl -H Metadata:true http://169.254.169.254/metadata/instance?api-version=2021-02-01"},
    "expect": "block"
  },
  {
    "name": "allows normal curl",
    "tool_name": "Bash",
    "tool_input": {"command": "curl https://api.github.com/repos/ipapast/policycheck"},
    "expect": "allow"
  }
]
